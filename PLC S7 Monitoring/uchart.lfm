    object pcSettings: TPageControl
      Left = 4
      Height = 512
      Top = 4
      Width = 262
      ActivePage = tsGeneral
      Align = alClient
      BorderSpacing.Around = 4
      TabIndex = 0
      TabOrder = 0
      object tsGeneral: TTabSheet
        Caption = 'General'
        object chkShowTitle: TCheckBox
          Left = 8
          Height = 19
          Top = 8
          Width = 120
          Caption = 'Show chart title'
          OnChange = ChartSettingChange
          TabOrder = 0
