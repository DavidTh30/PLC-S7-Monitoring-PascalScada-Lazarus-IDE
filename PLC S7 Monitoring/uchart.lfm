  object dlgExport: TSaveDialog
    Title = 'Export chart data'
    DefaultExt = '.csv'
    Filter = 'CSV file (*.csv)|*.csv|All files (*.*)|*.*'
    Options = [ofOverwritePrompt, ofEnableSizing, ofViewDetail]
    Left = 660
    Top = 200
  end
  object tmrSample: TTimer
    Interval = 500
    OnTimer = tmrSampleTimer
    Left = 600
    Top = 200
  end
