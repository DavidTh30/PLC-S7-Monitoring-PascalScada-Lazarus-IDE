      Left = 620
      Height = 15
      Top = 12
      Width = 32
      Caption = 'Zoom:'
    end
    object cbZoomMode: TComboBox
      Left = 658
      Height = 23
      Top = 8
      Width = 100
      Hint = 'Left drag = zoom box, right drag = pan, wheel = zoom'
      ItemHeight = 15
      ItemIndex = 0
      Items.Strings = (
        'Both axes'
        'Time only'
        'Value only'
      )
      OnChange = cbZoomModeChange
      ParentShowHint = False
